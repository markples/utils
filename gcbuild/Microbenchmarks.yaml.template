# Based on src\benchmarks\gc\GC.Infrastructure\GC.Infrastructure\Commands\RunCommand\BaseSuite\Microbenchmarks.yaml

microbenchmarks_path: C:\r\performance\src\benchmarks\micro
runs:
  {save_name}:
    dotnet_installer: net8.0
    name: {save_name}
    corerun: {core_root}\corerun.exe
    environment_variables:
      COMPlus_GCName: clrgcexp_{save_name}.dll
    is_baseline: true

microbenchmark_configurations:
  filter: 
  # Update this with the regex of the test you want to run.
  filter_path: c:\r\utils\gcbuild\MicrobenchmarksToRun.txt
  invocation_count_path: C:\r\performance\src\benchmarks\gc\GC.Infrastructure\Configurations\Microbenchmark\MicrobenchmarkInvocationCounts.psv
  bdn_arguments: --warmupCount 1 --iterationCount 20 --allStats --outliers DontRemove --keepFiles # --noOverheadEvaluation 
  dotnet_installer : net7.0

environment:
    default_max_seconds: 3000

trace_configurations:
  type: {trace_type}

output: 
  percentage_disk_remaining_to_stop_per_run: 0 
  formats:
    - markdown
    - json
  additional_report_metrics:
  cpu_columns:
  columns:
    - number of iterations
    - gc count
    - induced gc count
    - non induced gc count
    - standard error
    - standard error / mean
    - max size peak (mb)
    - total allocated (mb)
    - total pause time (msec)
    - gc pause time %
  all_columns:
    # GC Specific Columns 
    - gc count
    - non induced gc count
    - induced gc count
    - total allocated (mb)
    - max size peak (mb)
    - total pause time (msec)
    - gc pause time %
    - avg. heap size (mb)
    # BDN Based Columns 
    - number of iterations
    - min 
    - max 
    - median
    - q1
    - q3
    - variance
    - standard deviation
    - skewness
    - kurtosis
    - standard error
    - standard error / mean
  path: c:\home\repro\87826\micro_{save_name}_{trace_type}{output_suffix}
name: Net8_Testing 
